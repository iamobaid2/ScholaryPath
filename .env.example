# --- Firebase (client) : Firebase console → Project settings → Your apps → Web app ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin : Project settings → Service accounts → Generate new private key ---
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
# keep the quotes and the \n characters
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# --- Admin access: comma-separated emails that can open /admin ---
ADMIN_EMAILS=you@example.com
# optional: where new-order emails go (defaults to ADMIN_EMAILS)
ADMIN_NOTIFY_EMAIL=

# --- Email (SMTP). For Gmail use smtp.gmail.com, 587 and an App Password ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="ScholaryPath <you@example.com>"

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@scholarypath.com

# Set to true once Firebase Storage is enabled (file uploads)
NEXT_PUBLIC_ENABLE_UPLOADS=false
